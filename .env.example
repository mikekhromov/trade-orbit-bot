# Токен Telegram-бота от BotFather.
TOKEN_TG_BOT=

# Адрес API, доступный с сервера бота, например http://CORE_API_IP:8080
CORE_API_URL=

# Должен совпадать с INTERNAL_SERVICE_TOKEN в конфигурации Core API.
INTERNAL_SERVICE_TOKEN=

TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_INSECURE_SKIP_VERIFY=false
